<+><!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Paciente - Sistema Informático Hospitalario</title>\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <script>\r\n        tailwind.config = {\r\n            theme: {\r\n                extend: {\r\n                    colors: {\r\n                        brand: {\r\n                            black: '#121212',\r\n                            dark: '#1E1E1E',\r\n                            gray: '#2A2A2A',\r\n                            lightgray: '#F4F4F5',\r\n                            yellow: '#FACC15',\r\n                            yellowhover: '#EAB308'\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    </script>\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\r\n</head>\r\n<body class=\"bg-brand-lightgray font-sans antialiased min-h-screen\">\r\n\r\n<header class=\"bg-brand-black text-white\">\r\n    <div class=\"max-w-5xl mx-auto px-6 py-4 flex items-center justify-between\">\r\n        <div class=\"flex items-center gap-3\">\r\n            <i class=\"fa-solid fa-hospital text-brand-yellow text-2xl\"></i>\r\n            <span class=\"font-bold text-lg tracking-wide\">HIS <span class=\"text-brand-yellow\">Médico</span></span>\r\n            <span class=\"ml-3 px-3 py-1 bg-brand-dark rounded-full text-xs font-semibold text-gray-300\">Paciente</span>\r\n        </div>\r\n        <div class=\"flex items-center gap-4\">\r\n            <div class=\"text-right leading-tight hidden sm:block\">\r\n                <p id=\"nombrePacienteHeader\" class=\"text-sm font-semibold\">Cargando...</p>\r\n                <p class=\"text-xs text-gray-400\">Paciente</p>\r\n            </div>\r\n            <button onclick=\"cerrarSesionPaciente()\" title=\"Cerrar sesión\" class=\"text-gray-300 hover:text-brand-yellow\">\r\n                <i class=\"fa-solid fa-right-from-bracket text-lg\"></i>\r\n            </button>\r\n        </div>\r\n    </div>\r\n</header>\r\n\r\n<main class=\"max-w-5xl mx-auto px-6 py-8\">\r\n\r\n    <!-- ==================== VISTA: DASHBOARD ==================== -->\r\n    <div id=\"vistaDashboard\">\r\n        <div class=\"flex justify-between items-center mb-6 flex-wrap gap-3\">\r\n            <div>\r\n                <h1 class=\"text-2xl font-bold text-brand-black\">Bienvenido(a), <span id=\"nombrePacienteSaludo\">...</span></h1>\r\n                <p class=\"text-gray-500 text-sm\">Aquí puedes ver el estado de tus consultas, resultados y recetas.</p>\r\n            </div>\r\n            <button onclick=\"iniciarWizard()\"\r\n                    class=\"bg-brand-yellow hover:bg-brand-yellowhover text-brand-black font-bold px-5 py-3 rounded-lg shadow transition\">\r\n                <i class=\"fa-solid fa-calendar-plus mr-1\"></i> Agendar Cita\r\n            </button>\r\n        </div>\r\n\r\n        <div id=\"mensajesDashboard\"></div>\r\n\r\n        <h2 class=\"text-lg font-bold text-brand-black mb-3\">Mis Citas</h2>\r\n        <div id=\"listaMisCitas\" class=\"space-y-3\">\r\n            <p class=\"text-gray-400 text-sm\">Cargando tus citas...</p>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ==================== VISTA: WIZARD AGENDAR CITA ==================== -->\r\n    <div id=\"vistaWizard\" class=\"hidden\">\r\n        <div class=\"bg-white rounded-xl border border-gray-200 shadow-sm p-6 md:p-8\">\r\n            <div class=\"flex items-center justify-between mb-6\">\r\n                <h1 class=\"text-xl font-bold text-brand-black\">Agendar Cita</h1>\r\n                <button onclick=\"cancelarWizard()\" class=\"text-gray-400 hover:text-red-500 text-sm font-semibold\">\r\n                    <i class=\"fa-solid fa-xmark mr-1\"></i> Cancelar\r\n                </button>\r\n            </div>\r\n\r\n            <!-- Indicador de progreso de 5 pasos -->\r\n            <div class=\"flex items-center justify-between mb-8\">\r\n                <div class=\"flex-1 flex items-center\" id=\"pasoIndicador1\">\r\n                    <div class=\"pasoCirculo w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold\">1</div>\r\n                    <span class=\"ml-2 text-xs font-semibold hidden md:inline\">Sucursal</span>\r\n                    <div class=\"flex-1 h-0.5 bg-gray-200 mx-2\"></div>\r\n                </div>\r\n                <div class=\"flex-1 flex items-center\" id=\"pasoIndicador2\">\r\n                    <div class=\"pasoCirculo w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold\">2</div>\r\n                    <span class=\"ml-2 text-xs font-semibold hidden md:inline\">Especialidad</span>\r\n                    <div class=\"flex-1 h-0.5 bg-gray-200 mx-2\"></div>\r\n                </div>\r\n                <div class=\"flex-1 flex items-center\" id=\"pasoIndicador3\">\r\n                    <div class=\"pasoCirculo w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold\">3</div>\r\n                    <span class=\"ml-2 text-xs font-semibold hidden md:inline\">Médico</span>\r\n                    <div class=\"flex-1 h-0.5 bg-gray-200 mx-2\"></div>\r\n                </div>\r\n                <div class=\"flex-1 flex items-center\" id=\"pasoIndicador4\">\r\n                    <div class=\"pasoCirculo w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold\">4</div>\r\n                    <span class=\"ml-2 text-xs font-semibold hidden md:inline\">Fecha/Hora</span>\r\n                    <div class=\"flex-1 h-0.5 bg-gray-200 mx-2\"></div>\r\n                </div>\r\n                <div class=\"flex-1 flex items-center\" id=\"pasoIndicador5\">\r\n                    <div class=\"pasoCirculo w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold\">5</div>\r\n                    <span class=\"ml-2 text-xs font-semibold hidden md:inline\">Confirmar</span>\r\n                    <div class=\"flex-1 h-0.5 bg-gray-200 mx-2\"></div>\r\n                </div>\r\n                <div class=\"flex items-center\" id=\"pasoIndicador6\">\r\n                    <div class=\"pasoCirculo w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold\">6</div>\r\n                    <span class=\"ml-2 text-xs font-semibold hidden md:inline\">Pago</span>\r\n                </div>\r\n            </div>\r\n\r\n            <div id=\"mensajesWizard\"></div>\r\n\r\n            <!-- Paso 1: Sucursal -->\r\n            <div id=\"wizardPaso1\" class=\"hidden space-y-3\">\r\n                <h2 class=\"font-bold text-brand-black\">Selecciona una sucursal</h2>\r\n                <div id=\"listaSucursalesWizard\" class=\"grid grid-cols-1 md:grid-cols-2 gap-3\"></div>\r\n            </div>\r\n\r\n            <!-- Paso 2: Especialidad -->\r\n            <div id=\"wizardPaso2\" class=\"hidden space-y-3\">\r\n                <h2 class=\"font-bold text-brand-black\">Selecciona una especialidad</h2>\r\n                <div id=\"listaEspecialidadesWizard\" class=\"grid grid-cols-1 md:grid-cols-2 gap-3\"></div>\r\n                <button onclick=\"irAPaso(1)\" class=\"text-sm text-gray-500 hover:text-brand-black mt-2\"><i class=\"fa-solid fa-arrow-left mr-1\"></i> Volver</button>\r\n            </div>\r\n\r\n            <!-- Paso 3: Médico -->\r\n            <div id=\"wizardPaso3\" class=\"hidden space-y-3\">\r\n                <h2 class=\"font-bold text-brand-black\">Selecciona un médico</h2>\r\n                <div id=\"listaMedicosWizard\" class=\"grid grid-cols-1 md:grid-cols-2 gap-3\"></div>\r\n                <button onclick=\"irAPaso(2)\" class=\"text-sm text-gray-500 hover:text-brand-black mt-2\"><i class=\"fa-solid fa-arrow-left mr-1\"></i> Volver</button>\r\n            </div>\r\n\r\n            <!-- Paso 4: Fecha y hora -->\r\n            <div id=\"wizardPaso4\" class=\"hidden space-y-3\">\r\n                <h2 class=\"font-bold text-brand-black\">Selecciona fecha y hora</h2>\r\n                <div class=\"flex items-center gap-3\">\r\n                    <input id=\"wizardFecha\" type=\"date\" onchange=\"cargarHorariosWizard()\"\r\n                           class=\"p-2 border border-gray-300 rounded-md\">\r\n                </div>\r\n                <div id=\"listaHorariosWizard\" class=\"grid grid-cols-3 md:grid-cols-4 gap-2 mt-2\"></div>\r\n                <button onclick=\"irAPaso(3)\" class=\"text-sm text-gray-500 hover:text-brand-black mt-2\"><i class=\"fa-solid fa-arrow-left mr-1\"></i> Volver</button>\r\n            </div>\r\n\r\n            <!-- Paso 5: Confirmar -->\r\n            <div id=\"wizardPaso5\" class=\"hidden space-y-4\">\r\n                <h2 class=\"font-bold text-brand-black\">Confirma tu cita</h2>\r\n                <div class=\"bg-brand-lightgray border border-gray-200 rounded-lg p-4 text-sm space-y-1\">\r\n                    <p><strong>Sucursal:</strong> <span id=\"resumenSucursal\"></span></p>\r\n                    <p><strong>Especialidad:</strong> <span id=\"resumenEspecialidad\"></span></p>\r\n                    <p><strong>Médico:</strong> <span id=\"resumenMedico\"></span></p>\r\n                    <p><strong>Fecha y hora:</strong> <span id=\"resumenFechaHora\"></span></p>\r\n                </div>\r\n                <div>\r\n                    <label class=\"block text-sm font-medium text-gray-700\">Motivo de la consulta (10 a 2000 caracteres)</label>\r\n                    <textarea id=\"wizardMotivo\" rows=\"3\" maxlength=\"2000\"\r\n                              class=\"w-full p-2 border border-gray-300 rounded-md\"\r\n                              placeholder=\"Describe brevemente el motivo de tu consulta...\"></textarea>\r\n                </div>\r\n                <div class=\"flex gap-2\">\r\n                    <button onclick=\"irAPaso(4)\" class=\"flex-1 bg-gray-200 text-gray-800 font-semibold py-2 rounded-lg\">\r\n                        <i class=\"fa-solid fa-arrow-left mr-1\"></i> Volver\r\n                    </button>\r\n                    <button id=\"btnConfirmarCita\" onclick=\"confirmarCitaWizard()\"\r\n                            class=\"flex-1 bg-brand-yellow hover:bg-brand-yellowhover text-brand-black font-bold py-2 rounded-lg\">\r\n                        Confirmar Cita\r\n                    </button>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Paso 6: Método de pago (NUEVO) -->\r\n            <div id=\"wizardPaso6\" class=\"hidden space-y-4\">\r\n                <h2 class=\"font-bold text-brand-black\">¿Cómo deseas pagar tu cita?</h2>\r\n                <div class=\"bg-green-50 border border-green-200 rounded-lg p-4 text-sm text-green-800\">\r\n                    <i class=\"fa-solid fa-circle-check mr-1\"></i>\r\n                    Tu cita fue registrada correctamente con estado <strong>Pendiente de pago</strong>.\r\n                    Monto a pagar: <strong>Q<span id=\"montoPagoMetodo\">0.00</span></strong>.\r\n                </div>\r\n\r\n                <div id=\"mensajesMetodoPago\"></div>\r\n\r\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\r\n                    <button onclick=\"elegirPagoCaja()\" id=\"btnPagarCaja\"\r\n                            class=\"text-left p-5 border-2 border-gray-200 rounded-lg hover:border-brand-yellow hover:bg-brand-lightgray transition\">\r\n                        <i class=\"fa-solid fa-cash-register text-2xl text-brand-yellow mb-2 block\"></i>\r\n                        <p class=\"font-bold text-brand-black\">Pagar en caja</p>\r\n                        <p class=\"text-xs text-gray-500 mt-1\">Acércate a la ventanilla de caja de la clínica para\r\n                            realizar el pago antes de tu cita.</p>\r\n                    </button>\r\n                    <button onclick=\"elegirPagoEnLinea()\" id=\"btnPagarLinea\"\r\n                            class=\"text-left p-5 border-2 border-gray-200 rounded-lg hover:border-brand-yellow hover:bg-brand-lightgray transition\">\r\n                        <i class=\"fa-solid fa-credit-card text-2xl text-brand-yellow mb-2 block\"></i>\r\n                        <p class=\"font-bold text-brand-black\">Pagar en línea</p>\r\n                        <p class=\"text-xs text-gray-500 mt-1\">Paga ahora mismo con tarjeta. Tendrás\r\n                            <strong>5 minutos</strong> para completar el pago.</p>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Paso \"Pago en línea\" (fuera del indicador numerado de 6 pasos). -->\r\n            <div id=\"wizardPasoPagoLinea\" class=\"hidden space-y-4\">\r\n                <div class=\"flex items-center justify-between\">\r\n                    <h2 class=\"font-bold text-brand-black\">Pago en línea con tarjeta</h2>\r\n                    <span id=\"contadorPagoLinea\"\r\n                          class=\"px-3 py-1 rounded-full text-sm font-bold bg-red-100 text-red-700\">05:00</span>\r\n                </div>\r\n\r\n                <div class=\"bg-brand-lightgray border border-gray-200 rounded-lg p-4 text-sm space-y-1\">\r\n                    <p><strong>Especialidad:</strong> <span id=\"resumenPagoEspecialidad\"></span></p>\r\n                    <p><strong>Médico:</strong> <span id=\"resumenPagoMedico\"></span></p>\r\n                    <p><strong>Fecha y hora:</strong> <span id=\"resumenPagoFechaHora\"></span></p>\r\n                    <p><strong>Total a pagar:</strong> Q<span id=\"resumenPagoMonto\"></span></p>\r\n                </div>\r\n\r\n                <div id=\"mensajesPagoLinea\"></div>\r\n\r\n                <!-- Formulario de tarjeta -->\r\n                <div id=\"formPagoLinea\" class=\"space-y-3\">\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700\">Número de tarjeta</label>\r\n                        <input id=\"pagoNumeroTarjeta\" type=\"text\" inputmode=\"numeric\" maxlength=\"23\"\r\n                               placeholder=\"4111 1111 1111 1111\"\r\n                               oninput=\"formatearNumeroTarjeta()\"\r\n                               onfocus=\"restaurarNumeroTarjeta()\"\r\n                               onblur=\"enmascararNumeroTarjeta()\"\r\n                               class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700\">Nombre del titular</label>\r\n                        <input id=\"pagoNombreTitular\" type=\"text\" maxlength=\"100\"\r\n                               placeholder=\"Como aparece en la tarjeta\"\r\n                               oninput=\"this.value = this.value.toUpperCase()\"\r\n                               class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                    </div>\r\n                    <div class=\"flex gap-3\">\r\n                        <div class=\"flex-1\">\r\n                            <label class=\"block text-sm font-medium text-gray-700\">Vencimiento (MM/AA)</label>\r\n                            <input id=\"pagoVencimiento\" type=\"text\" maxlength=\"5\" placeholder=\"MM/AA\"\r\n                                   oninput=\"formatearVencimiento()\"\r\n                                   class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                        </div>\r\n                        <div class=\"flex-1\">\r\n                            <label class=\"block text-sm font-medium text-gray-700\">CVV</label>\r\n                            <input id=\"pagoCvv\" type=\"password\" maxlength=\"4\" placeholder=\"•••\"\r\n                                   oninput=\"this.value = this.value.replace(/\\\\D/g,'').slice(0,4)\"\r\n                                   class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                        </div>\r\n                    </div>\r\n                    <p class=\"text-xs text-gray-400\">\r\n                        <i class=\"fa-solid fa-lock mr-1\"></i>\r\n                        Tu información de pago está protegida. El CVV nunca se almacena.\r\n                    </p>\r\n\r\n                    <div class=\"flex gap-2 pt-2\">\r\n                        <button onclick=\"volverDesdeLinea()\"\r\n                                class=\"flex-1 bg-gray-200 text-gray-800 font-semibold py-2 rounded-lg\">\r\n                            <i class=\"fa-solid fa-arrow-left mr-1\"></i> Volver\r\n                        </button>\r\n                        <button id=\"btnPagarTarjeta\" onclick=\"pagarConTarjeta()\"\r\n                                class=\"flex-1 bg-brand-yellow hover:bg-brand-yellowhover text-brand-black font-bold py-2 rounded-lg\">\r\n                            Pagar Q<span id=\"montoBotonPagar\">0.00</span>\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Confirmación de pago exitoso -->\r\n                <div id=\"confirmacionPagoLinea\" class=\"hidden text-center space-y-3 py-4\">\r\n                    <i class=\"fa-solid fa-circle-check text-5xl text-green-500\"></i>\r\n                    <h3 class=\"text-lg font-bold text-brand-black\">¡Pago Exitoso!</h3>\r\n                    <p class=\"text-sm text-gray-600\">Número de transacción:\r\n                        <span id=\"txnPagoLinea\" class=\"font-semibold\"></span></p>\r\n                    <p class=\"text-sm text-gray-600\">Tu cita ha sido confirmada. Preséntate en recepción a la\r\n                        hora de tu cita.</p>\r\n                    <div class=\"flex gap-2 justify-center pt-2\">\r\n                        <button onclick=\"cancelarWizard()\"\r\n                                class=\"bg-brand-yellow hover:bg-brand-yellowhover text-brand-black font-bold px-4 py-2 rounded-lg\">\r\n                            Volver a Mis Citas\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</main>\r\n\r\n<!-- Modal: Detalle de cita + seguimiento del proceso -->\r\n<div id=\"modalDetalleCita\" class=\"hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4\">\r\n    <div class=\"bg-white rounded-xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto\">\r\n        <div class=\"flex justify-between items-center mb-4\">\r\n            <h3 class=\"text-lg font-bold text-brand-black\">Detalle de tu Cita</h3>\r\n            <button onclick=\"cerrarModalDetalleCita()\" class=\"text-gray-400 hover:text-red-500\"><i class=\"fa-solid fa-xmark text-lg\"></i></button>\r\n        </div>\r\n        <div id=\"detalleCitaBody\"></div>\r\n    </div>\r\n</div>\r\n\r\n<script>\r\n    // -------- Guard de sesión --------\r\n    if (!sessionStorage.getItem('jwt')) {\r\n        window.location.href = 'login.html';\r\n    }\r\n    const ID_PACIENTE = sessionStorage.getItem('usuarioId');\r\n    document.getElementById('nombrePacienteHeader').innerText = sessionStorage.getItem('nombreCompleto') || 'Paciente';\r\n    document.getElementById('nombrePacienteSaludo').innerText = sessionStorage.getItem('nombreCompleto') || '';\r\n\r\n    function cerrarSesionPaciente() {\r\n        sessionStorage.clear();\r\n        window.location.href = 'login.html';\r\n    }\r\n\r\n    function token() { return sessionStorage.getItem('jwt'); }\r\n\r\n    async function apiFetch(url, opciones = {}) {\r\n        const resp = await fetch(url, {\r\n            ...opciones,\r\n            headers: {\r\n                'Content-Type': 'application/json',\r\n                'Authorization': 'Bearer ' + token(),\r\n                ...(opciones.headers || {})\r\n            }\r\n        });\r\n        const data = await resp.json().catch(() => ({}));\r\n        if (!resp.ok) throw new Error(data.mensaje || data.message || 'Ocurrió un error inesperado.');\r\n        return data;\r\n    }\r\n\r\n    function mostrarMensajeDashboard(texto, tipo) {\r\n        const colores = {\r\n            error: 'bg-red-50 text-red-700 border border-red-200',\r\n            exito: 'bg-green-50 text-green-700 border border-green-200'\r\n        };\r\n        document.getElementById('mensajesDashboard').innerHTML =\r\n            `<div class=\"p-3 rounded-md mb-4 ${colores[tipo]}\">${texto}</div>`;\r\n    }\r\n\r\n    // ==================== Mis Citas ====================\r\n\r\n    const ESTADOS_TERMINALES_NEGATIVOS = ['Cancelada', 'No Asistió'];\r\n\r\n    function estadoColorClase(estado) {\r\n        const mapa = {\r\n            'Pendiente de pago': 'bg-amber-100 text-amber-700',\r\n            'Confirmada': 'bg-blue-100 text-blue-700',\r\n            'Paciente Presente': 'bg-indigo-100 text-indigo-700',\r\n            'Signos Vitales': 'bg-purple-100 text-purple-700',\r\n            'En Espera': 'bg-amber-100 text-amber-700',\r\n            'Consulta Médica': 'bg-yellow-100 text-yellow-800',\r\n            'Evaluado': 'bg-teal-100 text-teal-700',\r\n            'Atención Finalizada': 'bg-green-100 text-green-700',\r\n            'Cancelada': 'bg-red-100 text-red-700',\r\n            'No Asistió': 'bg-gray-200 text-gray-600'\r\n        };\r\n        return mapa[estado] || 'bg-gray-100 text-gray-700';\r\n    }\r\n\r\n    async function cargarMisCitas() {\r\n        try {\r\n            const citas = await apiFetch('/api/mis-citas');\r\n            const cont = document.getElementById('listaMisCitas');\r\n            if (citas.length === 0) {\r\n                cont.innerHTML = `<p class=\"text-gray-400 text-sm bg-white border border-gray-200 rounded-lg p-6 text-center\">Aún no tienes citas registradas. Presiona \"Agendar Cita\" para reservar la primera.</p>`;\r\n                return;\r\n            }\r\n            cont.innerHTML = citas.map(c => `\r\n                <div onclick=\"abrirDetalleCita(${c.id})\"\r\n                     class=\"bg-white border border-gray-200 rounded-lg p-4 shadow-sm cursor-pointer hover:shadow-md transition flex justify-between items-center gap-3\">\r\n                    <div>\r\n                        <p class=\"font-semibold text-brand-black\">${c.especialidad} — ${c.medico}</p>\r\n                        <p class=\"text-sm text-gray-500\">${c.sucursal} · ${new Date(c.fechaHora).toLocaleString('es-GT')}</p>\r\n                    </div>\r\n                    <span class=\"px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap ${estadoColorClase(c.estado)}\">${c.estado}</span>\r\n                </div>\r\n            `).join('');\r\n        } catch (e) {\r\n            mostrarMensajeDashboard(e.message, 'error');\r\n        }\r\n    }\r\n\r\n    // ==================== Detalle + seguimiento visual ====================\r\n\r\n    const PASOS_PROCESO = ['Pendiente de pago', 'Confirmada', 'Paciente Presente', 'Signos Vitales', 'En Espera', 'Consulta Médica', 'Evaluado', 'Atención Finalizada'];\r\n\r\n    function renderSeguimientoProceso(estadoActual) {\r\n        if (ESTADOS_TERMINALES_NEGATIVOS.includes(estadoActual)) {\r\n            const texto = estadoActual === 'Cancelada'\r\n                ? 'Esta cita fue cancelada.'\r\n                : 'No asististe a esta cita.';\r\n            return `<div class=\"p-3 rounded-md bg-red-50 text-red-700 border border-red-200 text-sm mb-4\">${texto}</div>`;\r\n        }\r\n\r\n        const indiceActual = PASOS_PROCESO.indexOf(estadoActual);\r\n        return `\r\n            <div class=\"mb-4\">\r\n                <div class=\"flex flex-wrap gap-2\">\r\n                    ${PASOS_PROCESO.map((paso, i) => `\r\n                        <div class=\"flex items-center gap-1 px-2 py-1 rounded-full text-[11px] font-semibold\r\n                             ${i <= indiceActual ? 'bg-brand-yellow text-brand-black' : 'bg-gray-100 text-gray-400'}\">\r\n                            ${i < indiceActual ? '<i class=\"fa-solid fa-check\"></i>' : ''} ${paso}\r\n                        </div>\r\n                    `).join('')}\r\n                </div>\r\n                ${estadoActual === 'Pendiente de pago' ? `\r\n                    <div class=\"mt-3 p-3 rounded-md bg-amber-50 text-amber-800 border border-amber-200 text-sm\">\r\n                        <i class=\"fa-solid fa-triangle-exclamation mr-1\"></i>\r\n                        Debes acercarte a caja a realizar el pago para confirmar tu reserva. Si no se paga a tiempo, el horario se libera automáticamente.\r\n                    </div>` : ''}\r\n            </div>\r\n        `;\r\n    }\r\n\r\n    let detalleCitaActual = null; // { id, medicoId } de la cita abierta en el modal, usado para reagendar\r\n\r\n    async function abrirDetalleCita(id) {\r\n        try {\r\n            const c = await apiFetch(`/api/mis-citas/${id}`);\r\n            detalleCitaActual = { id: c.id, medicoId: c.medicoId };\r\n            let html = renderSeguimientoProceso(c.estado);\r\n\r\n            html += `\r\n                <div class=\"text-sm space-y-1 mb-4\">\r\n                    <p><strong>Especialidad:</strong> ${c.especialidad}</p>\r\n                    <p><strong>Médico:</strong> ${c.medico}</p>\r\n                    <p><strong>Sucursal:</strong> ${c.sucursal}</p>\r\n                    <p><strong>Fecha/Hora:</strong> ${new Date(c.fechaHora).toLocaleString('es-GT')}</p>\r\n                    <p><strong>Motivo:</strong> ${c.motivoConsulta || '-'}</p>\r\n                    <p><strong>Monto:</strong> Q${Number(c.monto).toFixed(2)}</p>\r\n                </div>\r\n            `;\r\n\r\n            if (c.consulta) {\r\n                html += `\r\n                    <div class=\"border-t border-gray-100 pt-3 mb-4\">\r\n                        <h4 class=\"font-bold text-brand-black text-sm mb-2\"><i class=\"fa-solid fa-notes-medical mr-1\"></i> Consulta Médica</h4>\r\n                        <div class=\"text-sm space-y-1\">\r\n                            <p><strong>Motivo de visita:</strong> ${c.consulta.motivoVisita || '-'}</p>\r\n                            ${c.consulta.hallazgosClinicos ? `<p><strong>Hallazgos:</strong> ${c.consulta.hallazgosClinicos}</p>` : ''}\r\n                            ${c.consulta.diagnostico ? `<p><strong>Diagnóstico:</strong> ${c.consulta.diagnostico}</p>` : ''}\r\n                            ${c.consulta.planTratamiento ? `<p><strong>Plan de tratamiento:</strong> ${c.consulta.planTratamiento}</p>` : ''}\r\n                            <p><strong>Estado:</strong> ${c.consulta.finalizada ? 'Finalizada' : 'En curso'}</p>\r\n                        </div>\r\n                    </div>\r\n                `;\r\n            }\r\n\r\n            if (c.ordenLaboratorio) {\r\n                const o = c.ordenLaboratorio;\r\n                html += `\r\n                    <div class=\"border-t border-gray-100 pt-3 mb-4\">\r\n                        <h4 class=\"font-bold text-brand-black text-sm mb-2\"><i class=\"fa-solid fa-flask mr-1\"></i> Orden de Laboratorio #${o.id} — ${o.estadoNombre}</h4>\r\n                        <div class=\"space-y-2\">\r\n                            ${o.examenes.map(e => `\r\n                                <div class=\"text-sm bg-gray-50 rounded-md p-2\">\r\n                                    <p class=\"font-semibold\">${e.nombreExamen}</p>\r\n                                    ${e.publicado\r\n                    ? `<p>Resultado: ${e.valorResultado || '-'} ${e.unidad || ''} ${e.fueraDeRango ? '<span class=\"text-red-600 font-bold\">(Fuera de rango)</span>' : ''}</p>\r\n                                           ${e.rangoReferencia ? `<p class=\"text-gray-500 text-xs\">Rango de referencia: ${e.rangoReferencia}</p>` : ''}`\r\n                    : `<p class=\"text-gray-400 text-xs\">Resultado pendiente de publicación.</p>`}\r\n                                </div>\r\n                            `).join('')}\r\n                        </div>\r\n                    </div>\r\n                `;\r\n            }\r\n\r\n            if (c.recetas && c.recetas.length > 0) {\r\n                c.recetas.forEach(r => {\r\n                    html += `\r\n                        <div class=\"border-t border-gray-100 pt-3 mb-4\">\r\n                            <h4 class=\"font-bold text-brand-black text-sm mb-2\"><i class=\"fa-solid fa-pills mr-1\"></i> Receta Médica #${r.id}</h4>\r\n                            <div class=\"space-y-2\">\r\n                                ${r.medicamentos.map(m => `\r\n                                    <div class=\"text-sm bg-gray-50 rounded-md p-2\">\r\n                                        <p class=\"font-semibold\">${m.nombreMedicamento}</p>\r\n                                        <p>Dosis: ${m.dosis} · Frecuencia: ${m.frecuencia} · Duración: ${m.duracion}</p>\r\n                                        ${m.indicaciones ? `<p class=\"text-gray-500 text-xs\">${m.indicaciones}</p>` : ''}\r\n                                    </div>\r\n                                `).join('')}\r\n                            </div>\r\n                        </div>\r\n                    `;\r\n                });\r\n            }\r\n\r\n            if (c.estado === 'Pendiente de pago' || c.estado === 'Confirmada') {\r\n                html += `\r\n                    <div class=\"border-t border-gray-100 pt-3 mt-2\">\r\n                        <button onclick=\"abrirPanelReagendar()\"\r\n                                class=\"w-full bg-white border border-brand-black text-brand-black font-semibold px-4 py-2 rounded-lg hover:bg-gray-50 text-sm transition\">\r\n                            <i class=\"fa-solid fa-calendar-days mr-1\"></i> Reagendar Cita\r\n                        </button>\r\n                        <div id=\"panelReagendar\" class=\"hidden mt-3 p-3 border border-gray-200 rounded-lg bg-gray-50 space-y-3\">\r\n                            <div id=\"mensajesReagendar\"></div>\r\n                            <div>\r\n                                <label class=\"block text-xs font-medium text-gray-700\">Nueva Fecha</label>\r\n                                <input id=\"reagendarFecha\" type=\"date\" onchange=\"cargarHorariosReagendar()\"\r\n                                       class=\"w-full p-2 border border-gray-300 rounded-md text-sm\">\r\n                            </div>\r\n                            <div>\r\n                                <label class=\"block text-xs font-medium text-gray-700\">Hora Disponible</label>\r\n                                <select id=\"reagendarHorario\" class=\"w-full p-2 border border-gray-300 rounded-md text-sm\">\r\n                                    <option value=\"\">Seleccione una fecha primero</option>\r\n                                </select>\r\n                            </div>\r\n                            <div class=\"flex gap-2\">\r\n                                <button onclick=\"cerrarPanelReagendar()\" class=\"flex-1 bg-gray-200 text-gray-800 font-semibold py-2 rounded-lg text-sm\">Cancelar</button>\r\n                                <button onclick=\"confirmarReagendarCita()\" class=\"flex-1 bg-brand-yellow hover:bg-brand-yellowhover text-brand-black font-bold py-2 rounded-lg text-sm\">Confirmar Nuevo Horario</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                `;\r\n            }\r\n\r\n            document.getElementById('detalleCitaBody').innerHTML = html;\r\n            document.getElementById('modalDetalleCita').classList.remove('hidden');\r\n        } catch (e) {\r\n            mostrarMensajeDashboard(e.message, 'error');\r\n        }\r\n    }\r\n\r\n    function cerrarModalDetalleCita() {\r\n        document.getElementById('modalDetalleCita').classList.add('hidden');\r\n        detalleCitaActual = null;\r\n    }\r\n\r\n    // ==================== Reagendar Cita (desde el modal de detalle) ====================\r\n\r\n    function abrirPanelReagendar() {\r\n        document.getElementById('panelReagendar').classList.remove('hidden');\r\n        const manana = new Date();\r\n        manana.setDate(manana.getDate() + 1);\r\n        const pad = n => String(n).padStart(2, '0');\r\n        const fechaMin = `${manana.getFullYear()}-${pad(manana.getMonth() + 1)}-${pad(manana.getDate())}`;\r\n        document.getElementById('reagendarFecha').min = fechaMin;\r\n        document.getElementById('reagendarFecha').value = fechaMin;\r\n        document.getElementById('reagendarHorario').innerHTML = '<option value=\"\">Seleccione una fecha primero</option>';\r\n        document.getElementById('mensajesReagendar').innerHTML = '';\r\n        cargarHorariosReagendar();\r\n    }\r\n\r\n    function cerrarPanelReagendar() {\r\n        document.getElementById('panelReagendar').classList.add('hidden');\r\n    }\r\n\r\n    async function cargarHorariosReagendar() {\r\n        const fecha = document.getElementById('reagendarFecha').value;\r\n        const select = document.getElementById('reagendarHorario');\r\n        if (!fecha) { select.innerHTML = '<option value=\"\">Seleccione una fecha primero</option>'; return; }\r\n        select.innerHTML = '<option value=\"\">Cargando horarios...</option>';\r\n        try {\r\n            const data = await apiFetch(`/api/doctors/${detalleCitaActual.medicoId}/available-slots?date=${fecha}`);\r\n            const horarios = data.horarios || [];\r\n            if (!horarios.length) {\r\n                select.innerHTML = '<option value=\"\">Sin horarios disponibles para esta fecha</option>';\r\n                return;\r\n            }\r\n            select.innerHTML = horarios.map(h =>\r\n                `<option value=\"${h}\">${new Date(h).toLocaleTimeString('es-GT', { hour: '2-digit', minute: '2-digit' })}</option>`\r\n            ).join('');\r\n        } catch (e) {\r\n            document.getElementById('mensajesReagendar').innerHTML =\r\n                `<div class=\"p-2 rounded-md mb-2 bg-red-50 text-red-700 border border-red-200 text-xs\">${e.message}</div>`;\r\n        }\r\n    }\r\n\r\n    async function confirmarReagendarCita() {\r\n        document.getElementById('mensajesReagendar').innerHTML = '';\r\n        const horario = document.getElementById('reagendarHorario').value;\r\n        if (!horario) {\r\n            document.getElementById('mensajesReagendar').innerHTML =\r\n                '<div class=\"p-2 rounded-md mb-2 bg-red-50 text-red-700 border border-red-200 text-xs\">Debe seleccionar una fecha y hora disponibles.</div>';\r\n            return;\r\n        }\r\n        try {\r\n            await apiFetch(`/api/mis-citas/${detalleCitaActual.id}/reagendar`, {\r\n                method: 'PUT',\r\n                body: JSON.stringify({ fechaHora: horario })\r\n            });\r\n            cerrarModalDetalleCita();\r\n            mostrarMensajeDashboard('Tu cita ha sido reagendada exitosamente.', 'exito');\r\n            cargarMisCitas();\r\n        } catch (e) {\r\n            document.getElementById('mensajesReagendar').innerHTML =\r\n                `<div class=\"p-2 rounded-md mb-2 bg-red-50 text-red-700 border border-red-200 text-xs\">${e.message}</div>`;\r\n        }\r\n    }\r\n\r\n    // ==================== Wizard: Agendar Cita (CU-03) ====================\r\n\r\n    let wizardPasoActual = 1;\r\n    let wizardSeleccion = { sucursalId: null, sucursalNombre: '', especialidadId: null, especialidadNombre: '', medicoId: null, medicoNombre: '', fechaHora: null };\r\n    let citaCreada = null; // Cita ya registrada (Pendiente de pago), desde el paso 6 en adelante\r\n    let contadorPagoLineaInterval = null;\r\n    let pagoIdempotencyKey = null;\r\n\r\n    function mostrarMensajeWizard(texto, tipo) {\r\n        const colores = {\r\n            error: 'bg-red-50 text-red-700 border border-red-200',\r\n            info: 'bg-blue-50 text-blue-700 border border-blue-200'\r\n        };\r\n        document.getElementById('mensajesWizard').innerHTML = `<div class=\"p-3 rounded-md mb-4 ${colores[tipo]}\">${texto}</div>`;\r\n    }\r\n\r\n    function iniciarWizard() {\r\n        wizardSeleccion = { sucursalId: null, sucursalNombre: '', especialidadId: null, especialidadNombre: '', medicoId: null, medicoNombre: '', fechaHora: null };\r\n        document.getElementById('vistaDashboard').classList.add('hidden');\r\n        document.getElementById('vistaWizard').classList.remove('hidden');\r\n        irAPaso(1);\r\n    }\r\n\r\n    function cancelarWizard() {\r\n        if (typeof detenerContadorPagoLinea === 'function') detenerContadorPagoLinea();\r\n        citaCreada = null;\r\n        document.getElementById('vistaWizard').classList.add('hidden');\r\n        document.getElementById('vistaDashboard').classList.remove('hidden');\r\n        cargarMisCitas();\r\n    }\r\n\r\n    function irAPaso(n) {\r\n        wizardPasoActual = n;\r\n        document.getElementById('mensajesWizard').innerHTML = '';\r\n        // Por si se venía del paso de pago en línea (Parte 3), lo ocultamos\r\n        // y detenemos su contador si existe.\r\n        document.getElementById('wizardPasoPagoLinea').classList.add('hidden');\r\n        if (typeof detenerContadorPagoLinea === 'function') detenerContadorPagoLinea();\r\n\r\n        for (let i = 1; i <= 6; i++) {\r\n            document.getElementById(`wizardPaso${i}`).classList.toggle('hidden', i !== n);\r\n            const circulo = document.querySelector(`#pasoIndicador${i} .pasoCirculo`);\r\n            circulo.className = `pasoCirculo w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold ${\r\n                i < n ? 'bg-green-500 text-white' : i === n ? 'bg-brand-yellow text-brand-black' : 'bg-gray-200 text-gray-500'\r\n            }`;\r\n        }\r\n        if (n === 1) cargarSucursalesWizard();\r\n        if (n === 5) llenarResumenWizard();\r\n    }\r\n\r\n    async function cargarSucursalesWizard() {\r\n        try {\r\n            const sucursales = await apiFetch('/api/branches');\r\n            document.getElementById('listaSucursalesWizard').innerHTML = sucursales.map(s => `\r\n                <button onclick=\"seleccionarSucursal(${s.id}, '${(s.nombre || '').replace(/'/g, \"\\\\'\")}')\"\r\n                        class=\"text-left p-4 border border-gray-200 rounded-lg hover:border-brand-yellow hover:bg-brand-lightgray transition\">\r\n                    <i class=\"fa-solid fa-location-dot text-brand-yellow mr-2\"></i>\r\n                    <span class=\"font-semibold\">${s.nombre}</span>\r\n                </button>\r\n            `).join('');\r\n        } catch (e) {\r\n            mostrarMensajeWizard(e.message, 'error');\r\n        }\r\n    }\r\n\r\n    function seleccionarSucursal(id, nombre) {\r\n        wizardSeleccion.sucursalId = id;\r\n        wizardSeleccion.sucursalNombre = nombre;\r\n        wizardSeleccion.especialidadId = null;\r\n        wizardSeleccion.medicoId = null;\r\n        irAPaso(2);\r\n        cargarEspecialidadesWizard();\r\n    }\r\n\r\n    async function cargarEspecialidadesWizard() {\r\n        try {\r\n            const especialidades = await apiFetch(`/api/branches/${wizardSeleccion.sucursalId}/specialties`);\r\n            document.getElementById('listaEspecialidadesWizard').innerHTML = especialidades.map(e => `\r\n                <button onclick=\"seleccionarEspecialidad(${e.id}, '${(e.nombre || '').replace(/'/g, \"\\\\'\")}')\"\r\n                        class=\"text-left p-4 border border-gray-200 rounded-lg hover:border-brand-yellow hover:bg-brand-lightgray transition\">\r\n                    <i class=\"fa-solid fa-stethoscope text-brand-yellow mr-2\"></i>\r\n                    <span class=\"font-semibold\">${e.nombre}</span>\r\n                </button>\r\n            `).join('');\r\n        } catch (e) {\r\n            // FA01: No hay especialidades disponibles en la sucursal\r\n            mostrarMensajeWizard(e.message, 'error');\r\n            document.getElementById('listaEspecialidadesWizard').innerHTML = '';\r\n        }\r\n    }\r\n\r\n    function seleccionarEspecialidad(id, nombre) {\r\n        wizardSeleccion.especialidadId = id;\r\n        wizardSeleccion.especialidadNombre = nombre;\r\n        wizardSeleccion.medicoId = null;\r\n        irAPaso(3);\r\n        cargarMedicosWizard();\r\n    }\r\n\r\n    async function cargarMedicosWizard() {\r\n        try {\r\n            const medicos = await apiFetch(`/api/branches/${wizardSeleccion.sucursalId}/specialties/${wizardSeleccion.especialidadId}/doctors`);\r\n            document.getElementById('listaMedicosWizard').innerHTML = medicos.map(m => `\r\n                <button onclick=\"seleccionarMedico(${m.id}, '${(m.nombreCompleto || '').replace(/'/g, \"\\\\'\")}')\"\r\n                        class=\"text-left p-4 border border-gray-200 rounded-lg hover:border-brand-yellow hover:bg-brand-lightgray transition\">\r\n                    <i class=\"fa-solid fa-user-doctor text-brand-yellow mr-2\"></i>\r\n                    <span class=\"font-semibold\">${m.nombreCompleto}</span>\r\n                </button>\r\n            `).join('');\r\n        } catch (e) {\r\n            // FA02: No hay médicos o disponibilidad\r\n            mostrarMensajeWizard(e.message, 'error');\r\n            document.getElementById('listaMedicosWizard').innerHTML = '';\r\n        }\r\n    }\r\n\r\n    function seleccionarMedico(id, nombre) {\r\n        wizardSeleccion.medicoId = id;\r\n        wizardSeleccion.medicoNombre = nombre;\r\n        wizardSeleccion.fechaHora = null;\r\n        irAPaso(4);\r\n\r\n        const manana = new Date();\r\n        manana.setDate(manana.getDate() + 1);\r\n        const pad = n => String(n).padStart(2, '0');\r\n        document.getElementById('wizardFecha').value = `${manana.getFullYear()}-${pad(manana.getMonth() + 1)}-${pad(manana.getDate())}`;\r\n        document.getElementById('wizardFecha').min = document.getElementById('wizardFecha').value;\r\n        cargarHorariosWizard();\r\n    }\r\n\r\n    async function cargarHorariosWizard() {\r\n        const fecha = document.getElementById('wizardFecha').value;\r\n        if (!fecha) return;\r\n        try {\r\n            const data = await apiFetch(`/api/doctors/${wizardSeleccion.medicoId}/available-slots?date=${fecha}`);\r\n            const horarios = data.horarios || [];\r\n            const cont = document.getElementById('listaHorariosWizard');\r\n            if (horarios.length === 0) {\r\n                cont.innerHTML = `<p class=\"col-span-full text-sm text-gray-400\">No se encontraron horarios disponibles para la especialidad ${wizardSeleccion.especialidadNombre} en la Sede ${wizardSeleccion.sucursalNombre}. Por favor, seleccione otra fecha, especialidad o sede.</p>`;\r\n                return;\r\n            }\r\n            cont.innerHTML = horarios.map(h => `\r\n                <button onclick=\"seleccionarHorario('${h}')\"\r\n                        class=\"p-2 border border-gray-200 rounded-lg text-sm font-semibold hover:border-brand-yellow hover:bg-brand-lightgray transition\">\r\n                    ${new Date(h).toLocaleTimeString('es-GT', {hour: '2-digit', minute: '2-digit'})}\r\n                </button>\r\n            `).join('');\r\n        } catch (e) {\r\n            mostrarMensajeWizard(e.message, 'error');\r\n        }\r\n    }\r\n\r\n    function seleccionarHorario(fechaHoraISO) {\r\n        wizardSeleccion.fechaHora = fechaHoraISO;\r\n        irAPaso(5);\r\n    }\r\n\r\n    function llenarResumenWizard() {\r\n        document.getElementById('resumenSucursal').innerText = wizardSeleccion.sucursalNombre;\r\n        document.getElementById('resumenEspecialidad').innerText = wizardSeleccion.especialidadNombre;\r\n        document.getElementById('resumenMedico').innerText = wizardSeleccion.medicoNombre;\r\n        document.getElementById('resumenFechaHora').innerText = new Date(wizardSeleccion.fechaHora).toLocaleString('es-GT');\r\n    }\r\n\r\n    async function confirmarCitaWizard() {\r\n        const motivo = document.getElementById('wizardMotivo').value.trim();\r\n        if (motivo.length < 10 || motivo.length > 2000) {\r\n            mostrarMensajeWizard('El motivo debe contener entre 10 y 2000 caracteres.', 'error');\r\n            return;\r\n        }\r\n\r\n        const btn = document.getElementById('btnConfirmarCita');\r\n        btn.disabled = true;\r\n        btn.innerText = 'Confirmando...';\r\n\r\n        try {\r\n            const cita = await apiFetch('/api/appointments', {\r\n                method: 'POST',\r\n                body: JSON.stringify({\r\n                    pacienteId: Number(ID_PACIENTE),\r\n                    sucursalId: wizardSeleccion.sucursalId,\r\n                    especialidadId: wizardSeleccion.especialidadId,\r\n                    medicoId: wizardSeleccion.medicoId,\r\n                    fechaHora: wizardSeleccion.fechaHora,\r\n                    motivoConsulta: motivo\r\n                })\r\n            });\r\n\r\n            // La cita ya quedó registrada como \"Pendiente de pago\". Ahora se\r\n            // le pregunta al paciente cómo desea pagar (paso 6, NUEVO).\r\n            citaCreada = cita;\r\n            document.getElementById('montoPagoMetodo').innerText = Number(cita.monto).toFixed(2);\r\n            document.getElementById('mensajesMetodoPago').innerHTML = '';\r\n            irAPaso(6);\r\n        } catch (e) {\r\n            // FA03: horario ya no disponible u otro error de validación\r\n            mostrarMensajeWizard(e.message, 'error');\r\n        } finally {\r\n            btn.disabled = false;\r\n            btn.innerText = 'Confirmar Cita';\r\n        }\r\n    }\r\n\r\n    // ==================== Paso 6 (NUEVO): elegir método de pago ====================\r\n\r\n    function mostrarMensajeMetodoPago(texto, tipo) {\r\n        const colores = {\r\n            error: 'bg-red-50 text-red-700 border border-red-200',\r\n            info: 'bg-blue-50 text-blue-700 border border-blue-200'\r\n        };\r\n        document.getElementById('mensajesMetodoPago').innerHTML =\r\n            `<div class=\"p-3 rounded-md ${colores[tipo]}\">${texto}</div>`;\r\n    }\r\n\r\n    function bloquearBotonesMetodoPago(bloquear) {\r\n        document.getElementById('btnPagarCaja').classList.toggle('opacity-50', bloquear);\r\n        document.getElementById('btnPagarCaja').classList.toggle('pointer-events-none', bloquear);\r\n        document.getElementById('btnPagarLinea').classList.toggle('opacity-50', bloquear);\r\n        document.getElementById('btnPagarLinea').classList.toggle('pointer-events-none', bloquear);\r\n    }\r\n\r\n    async function elegirPagoCaja() {\r\n        bloquearBotonesMetodoPago(true);\r\n        mostrarMensajeMetodoPago('Registrando tu elección...', 'info');\r\n        try {\r\n            await apiFetch(`/api/appointments/${citaCreada.id}/metodo-pago`, {\r\n                method: 'POST',\r\n                body: JSON.stringify({ metodoPago: 'CAJA' })\r\n            });\r\n\r\n            citaCreada = null;\r\n            document.getElementById('vistaWizard').classList.add('hidden');\r\n            document.getElementById('vistaDashboard').classList.remove('hidden');\r\n            mostrarMensajeDashboard(\r\n                'Tu cita ha sido registrada exitosamente. Acércate a caja para realizar el pago y confirmar tu reserva.',\r\n                'exito'\r\n            );\r\n            cargarMisCitas();\r\n        } catch (e) {\r\n            mostrarMensajeMetodoPago(e.message, 'error');\r\n            bloquearBotonesMetodoPago(false);\r\n        }\r\n    }\r\n\r\n    async function elegirPagoEnLinea() {\r\n        bloquearBotonesMetodoPago(true);\r\n        mostrarMensajeMetodoPago('Preparando el pago en línea...', 'info');\r\n        try {\r\n            // Al elegir \"LINEA\" el backend le pone 5 minutos de plazo (expiraEn)\r\n            // a la cita para completar el pago con tarjeta.\r\n            const cita = await apiFetch(`/api/appointments/${citaCreada.id}/metodo-pago`, {\r\n                method: 'POST',\r\n                body: JSON.stringify({ metodoPago: 'LINEA' })\r\n            });\r\n            citaCreada = cita;\r\n\r\n            if (typeof iniciarPagoEnLinea === 'function') {\r\n                // Función que se agrega en la Parte 3: pinta el formulario de\r\n                // tarjeta y arranca el contador regresivo de 5 minutos.\r\n                iniciarPagoEnLinea(cita);\r\n            } else {\r\n                mostrarMensajeMetodoPago(\r\n                    'La pantalla de pago en línea todavía no está agregada (Parte 3 pendiente).', 'error');\r\n                bloquearBotonesMetodoPago(false);\r\n            }\r\n        } catch (e) {\r\n            mostrarMensajeMetodoPago(e.message, 'error');\r\n            bloquearBotonesMetodoPago(false);\r\n        }\r\n    }\r\n\r\n    // -------- Inicio --------\r\n    cargarMisCitas();\r\n\r\n    // ==================== Pago en línea (NUEVO) — formulario + contador 5 min ====================\r\n\r\n    function iniciarPagoEnLinea(cita) {\r\n        document.getElementById('wizardPaso6').classList.add('hidden');\r\n        document.getElementById('wizardPasoPagoLinea').classList.remove('hidden');\r\n        document.getElementById('formPagoLinea').classList.remove('hidden');\r\n        document.getElementById('confirmacionPagoLinea').classList.add('hidden');\r\n        document.getElementById('mensajesPagoLinea').innerHTML = '';\r\n        bloquearBotonesMetodoPago(false);\r\n\r\n        document.getElementById('resumenPagoEspecialidad').innerText = wizardSeleccion.especialidadNombre;\r\n        document.getElementById('resumenPagoMedico').innerText = wizardSeleccion.medicoNombre;\r\n        document.getElementById('resumenPagoFechaHora').innerText = new Date(wizardSeleccion.fechaHora).toLocaleString('es-GT');\r\n        document.getElementById('resumenPagoMonto').innerText = Number(cita.monto).toFixed(2);\r\n        document.getElementById('montoBotonPagar').innerText = Number(cita.monto).toFixed(2);\r\n\r\n        const numeroInput = document.getElementById('pagoNumeroTarjeta');\r\n        numeroInput.value = '';\r\n        numeroInput.dataset.numeroCompleto = '';\r\n        document.getElementById('pagoNombreTitular').value = '';\r\n        document.getElementById('pagoVencimiento').value = '';\r\n        document.getElementById('pagoCvv').value = '';\r\n\r\n        const btn = document.getElementById('btnPagarTarjeta');\r\n        btn.disabled = false;\r\n        btn.innerHTML = `Pagar Q<span id=\"montoBotonPagar\">${Number(cita.monto).toFixed(2)}</span>`;\r\n\r\n        pagoIdempotencyKey = null; // se genera al momento de pagar\r\n\r\n        // cita.expiraEn viene del servidor (ahora + 5 minutos, ver\r\n        // CitaService.elegirMetodoPago) — el contador se calcula contra esa\r\n        // hora real, no contra un contador local, para evitar desfaces.\r\n        iniciarContadorPagoLinea(cita.sesionPagoExpiraEn);\r\n    }\r\n\r\n    // El contador llegó a 0 sin que se completara el pago: se cancela la\r\n    // cita de inmediato (no se genera cita para pagar después en caja) y se\r\n    // redirige al paciente, igual que el patrón de CU-04 FA02.\r\n    async function expirarPagoEnLinea() {\r\n        detenerContadorPagoLinea();\r\n        document.getElementById('formPagoLinea').classList.add('hidden');\r\n        document.getElementById('mensajesPagoLinea').innerHTML = `\r\n            <div class=\"p-3 rounded-md bg-red-50 text-red-700 border border-red-200 text-sm\">\r\n                <i class=\"fa-solid fa-triangle-exclamation mr-1\"></i>\r\n                El tiempo para confirmar tu cita ha expirado. La cita ha sido cancelada.\r\n                Serás redirigido en unos segundos...\r\n            </div>`;\r\n\r\n        try {\r\n            if (citaCreada) {\r\n                await apiFetch(`/api/appointments/${citaCreada.id}/cancelar-expirada`, { method: 'POST' });\r\n            }\r\n        } catch (e) {\r\n            // Si esta llamada falla por cualquier motivo, PagoService cancela\r\n            // la cita igual en el siguiente intento de pago (respaldo).\r\n        }\r\n\r\n        setTimeout(() => {\r\n            citaCreada = null;\r\n            document.getElementById('vistaWizard').classList.add('hidden');\r\n            document.getElementById('vistaDashboard').classList.remove('hidden');\r\n            mostrarMensajeDashboard(\r\n                'El tiempo para pagar en línea expiró y tu cita fue cancelada automáticamente. ' +\r\n                'Puedes agendar una nueva cita cuando quieras.',\r\n                'error'\r\n            );\r\n            cargarMisCitas();\r\n        }, 4000);\r\n    }\r\n\r\n    function detenerContadorPagoLinea() {\r\n        if (contadorPagoLineaInterval) {\r\n            clearInterval(contadorPagoLineaInterval);\r\n            contadorPagoLineaInterval = null;\r\n        }\r\n    }\r\n\r\n    // El contador llegó a 0 sin que se completara el pago: se cancela la\r\n    // cita de inmediato (no se genera cita para pagar después en caja) y se\r\n    // redirige al paciente, igual que el patrón de CU-04 FA02.\r\n    async function expirarPagoEnLinea() {\r\n        detenerContadorPagoLinea();\r\n        document.getElementById('formPagoLinea').classList.add('hidden');\r\n        document.getElementById('mensajesPagoLinea').innerHTML = `\r\n            <div class=\"p-3 rounded-md bg-red-50 text-red-700 border border-red-200 text-sm\">\r\n                <i class=\"fa-solid fa-triangle-exclamation mr-1\"></i>\r\n                El tiempo para confirmar tu cita ha expirado. La cita ha sido cancelada.\r\n                Serás redirigido en unos segundos...\r\n            </div>`;\r\n\r\n        try {\r\n            if (citaCreada) {\r\n                await apiFetch(`/api/appointments/${citaCreada.id}/cancelar-expirada`, { method: 'POST' });\r\n            }\r\n        } catch (e) {\r\n            // Si esta llamada falla por cualquier motivo, el job de fondo del\r\n            // servidor cancela la cita de todas formas en un máximo de 60s.\r\n        }\r\n\r\n        setTimeout(() => {\r\n            citaCreada = null;\r\n            document.getElementById('vistaWizard').classList.add('hidden');\r\n            document.getElementById('vistaDashboard').classList.remove('hidden');\r\n            mostrarMensajeDashboard(\r\n                'El tiempo para pagar en línea expiró y tu cita fue cancelada automáticamente. ' +\r\n                'Puedes agendar una nueva cita cuando quieras.',\r\n                'error'\r\n            );\r\n            cargarMisCitas();\r\n        }, 4000);\r\n    }\r\n\r\n    function volverDesdeLinea() {\r\n        detenerContadorPagoLinea();\r\n        document.getElementById('wizardPasoPagoLinea').classList.add('hidden');\r\n        document.getElementById('wizardPaso6').classList.remove('hidden');\r\n    }\r\n\r\n    // -------- Formateo de campos de tarjeta --------\r\n\r\n    function formatearNumeroTarjeta() {\r\n        const input = document.getElementById('pagoNumeroTarjeta');\r\n        const digitos = input.value.replace(/\\D/g, '').slice(0, 19);\r\n        input.dataset.numeroCompleto = digitos;\r\n        input.value = digitos.replace(/(.{4})/g, '$1 ').trim();\r\n    }\r\n\r\n    function restaurarNumeroTarjeta() {\r\n        const input = document.getElementById('pagoNumeroTarjeta');\r\n        const digitos = input.dataset.numeroCompleto || '';\r\n        input.value = digitos.replace(/(.{4})/g, '$1 ').trim();\r\n    }\r\n\r\n    // Al salir del campo se enmascara mostrando solo los últimos 4 dígitos\r\n    // (RN-CU04-01 / RNF-012), sin perder el número completo guardado en\r\n    // dataset.numeroCompleto para poder enviarlo al backend.\r\n    function enmascararNumeroTarjeta() {\r\n        const input = document.getElementById('pagoNumeroTarjeta');\r\n        const digitos = input.dataset.numeroCompleto || input.value.replace(/\\D/g, '');\r\n        input.dataset.numeroCompleto = digitos;\r\n        if (digitos.length >= 4) {\r\n            input.value = '**** **** **** ' + digitos.slice(-4);\r\n        }\r\n    }\r\n\r\n    function formatearVencimiento() {\r\n        const input = document.getElementById('pagoVencimiento');\r\n        let valor = input.value.replace(/\\D/g, '').slice(0, 4);\r\n        if (valor.length >= 3) {\r\n            valor = valor.slice(0, 2) + '/' + valor.slice(2);\r\n        }\r\n        input.value = valor;\r\n    }\r\n\r\n    // -------- Enviar el pago --------\r\n\r\n    async function pagarConTarjeta() {\r\n        const numeroInput = document.getElementById('pagoNumeroTarjeta');\r\n        const numeroTarjeta = (numeroInput.dataset.numeroCompleto || numeroInput.value).replace(/\\D/g, '');\r\n        const nombreTitular = document.getElementById('pagoNombreTitular').value.trim();\r\n        const vencimiento = document.getElementById('pagoVencimiento').value.trim();\r\n        const cvv = document.getElementById('pagoCvv').value.trim();\r\n\r\n        document.getElementById('mensajesPagoLinea').innerHTML = '';\r\n\r\n        const btn = document.getElementById('btnPagarTarjeta');\r\n        const textoOriginal = btn.innerHTML;\r\n        btn.disabled = true;\r\n        btn.innerText = 'Procesando pago...';\r\n\r\n        // Idempotencia (RNF-016): mismo UUID aunque el usuario haga doble clic\r\n        // o reintente tras un error; solo se regenera en un intento nuevo real.\r\n        if (!pagoIdempotencyKey) {\r\n            pagoIdempotencyKey = (crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`);\r\n        }\r\n\r\n        try {\r\n            const resultado = await apiFetch('/api/payments', {\r\n                method: 'POST',\r\n                body: JSON.stringify({\r\n                    citaId: citaCreada.id,\r\n                    numeroTarjeta,\r\n                    nombreTitular,\r\n                    vencimiento,\r\n                    cvv,\r\n                    idempotencyKey: pagoIdempotencyKey\r\n                })\r\n            });\r\n\r\n            detenerContadorPagoLinea();\r\n            document.getElementById('formPagoLinea').classList.add('hidden');\r\n            document.getElementById('txnPagoLinea').innerText = resultado.numeroTransaccion;\r\n            document.getElementById('confirmacionPagoLinea').classList.remove('hidden');\r\n            citaCreada = null;\r\n        } catch (e) {\r\n            // FA01/FA03 de CU-04: validación de campos o rechazo de la pasarela.\r\n            // El formulario permanece activo y el contador sigue corriendo,\r\n            // el paciente puede corregir los datos y reintentar sin perder la reserva.\r\n            document.getElementById('mensajesPagoLinea').innerHTML =\r\n                `<div class=\"p-3 rounded-md bg-red-50 text-red-700 border border-red-200 text-sm\">${e.message}</div>`;\r\n            btn.disabled = false;\r\n            btn.innerHTML = textoOriginal;\r\n        }\r\n    }\r\n</script>\r\n</body>\r\n</html>
