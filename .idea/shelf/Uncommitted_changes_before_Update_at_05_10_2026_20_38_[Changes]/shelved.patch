<+><!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Registro de Paciente - Sistema Informático Hospitalario</title>\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <script>\r\n        tailwind.config = {\r\n            theme: {\r\n                extend: {\r\n                    colors: {\r\n                        brand: {\r\n                            black: '#121212',\r\n                            dark: '#1E1E1E',\r\n                            gray: '#2A2A2A',\r\n                            lightgray: '#F4F4F5',\r\n                            yellow: '#FACC15',\r\n                            yellowhover: '#EAB308'\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    </script>\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\r\n</head>\r\n<body class=\"bg-brand-lightgray font-sans antialiased min-h-screen flex items-center justify-center py-10\">\r\n\r\n<div class=\"w-full max-w-lg\">\r\n\r\n    <div class=\"text-center mb-6\">\r\n        <div class=\"inline-flex items-center gap-3 bg-brand-black px-6 py-3 rounded-xl\">\r\n            <i class=\"fa-solid fa-hospital text-brand-yellow text-2xl\"></i>\r\n            <span class=\"font-bold text-lg tracking-wide text-white\">HIS <span class=\"text-brand-yellow\">Médico</span></span>\r\n        </div>\r\n    </div>\r\n\r\n    <form id=\"formRegistro\" class=\"bg-white p-8 rounded-xl border border-gray-200 shadow-sm space-y-4\">\r\n        <h1 class=\"text-lg font-bold text-brand-black text-center mb-2\">Registro de Paciente</h1>\r\n\r\n        <div id=\"mensajeGlobal\" class=\"hidden p-3 rounded-md text-sm\"></div>\r\n\r\n        <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Nombre Completo</label>\r\n            <input id=\"nombreCompleto\" required minlength=\"10\" maxlength=\"100\"\r\n                   class=\"w-full p-2 border border-gray-300 rounded-md focus:ring-brand-yellow focus:border-brand-yellow\"\r\n                   placeholder=\"Nombre y apellidos completos\">\r\n            <p class=\"error-text hidden text-red-600 text-xs mt-1\"></p>\r\n        </div>\r\n\r\n        <div class=\"grid grid-cols-2 gap-3\">\r\n            <div>\r\n                <label class=\"block text-sm font-medium text-gray-700 mb-1\">DPI</label>\r\n                <input id=\"dpi\" required maxlength=\"13\" inputmode=\"numeric\"\r\n                       class=\"w-full p-2 border border-gray-300 rounded-md focus:ring-brand-yellow focus:border-brand-yellow\"\r\n                       placeholder=\"13 dígitos\">\r\n                <p class=\"text-xs text-gray-400 mt-1\"><span id=\"dpiContador\">0</span>/13 dígitos</p>\r\n                <p class=\"error-text hidden text-red-600 text-xs mt-1\"></p>\r\n            </div>\r\n            <div>\r\n                <label class=\"block text-sm font-medium text-gray-700 mb-1\">NIT</label>\r\n                <input id=\"nit\" required maxlength=\"9\"\r\n                       class=\"w-full p-2 border border-gray-300 rounded-md focus:ring-brand-yellow focus:border-brand-yellow\"\r\n                       placeholder=\"8-9 caracteres\">\r\n                <p class=\"error-text hidden text-red-600 text-xs mt-1\"></p>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"grid grid-cols-2 gap-3\">\r\n            <div>\r\n                <label class=\"block text-sm font-medium text-gray-700 mb-1\">Teléfono</label>\r\n                <input id=\"telefono\" required maxlength=\"8\" inputmode=\"numeric\"\r\n                       class=\"w-full p-2 border border-gray-300 rounded-md focus:ring-brand-yellow focus:border-brand-yellow\"\r\n                       placeholder=\"8 dígitos\">\r\n                <p class=\"error-text hidden text-red-600 text-xs mt-1\"></p>\r\n            </div>\r\n            <div>\r\n                <label class=\"block text-sm font-medium text-gray-700 mb-1\">No. Afiliado Seguro (opcional)</label>\r\n                <input id=\"numeroSeguro\" maxlength=\"50\"\r\n                       class=\"w-full p-2 border border-gray-300 rounded-md focus:ring-brand-yellow focus:border-brand-yellow\">\r\n                <p class=\"error-text hidden text-red-600 text-xs mt-1\"></p>\r\n            </div>\r\n        </div>\r\n\r\n        <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Correo Electrónico</label>\r\n            <input id=\"correoElectronico\" type=\"email\" required\r\n                   class=\"w-full p-2 border border-gray-300 rounded-md focus:ring-brand-yellow focus:border-brand-yellow\"\r\n                   placeholder=\"usuario@dominio.com\">\r\n            <p class=\"error-text hidden text-red-600 text-xs mt-1\"></p>\r\n        </div>\r\n\r\n        <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Nombre de Usuario</label>\r\n            <input id=\"nombreUsuario\" required minlength=\"8\" maxlength=\"9\"\r\n                   class=\"w-full p-2 border border-gray-300 rounded-md focus:ring-brand-yellow focus:border-brand-yellow\"\r\n                   placeholder=\"8-9 caracteres alfanuméricos\">\r\n            <p class=\"error-text hidden text-red-600 text-xs mt-1\"></p>\r\n        </div>\r\n\r\n        <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Contraseña</label>\r\n            <input id=\"password\" type=\"password\" required minlength=\"12\"\r\n                   class=\"w-full p-2 border border-gray-300 rounded-md focus:ring-brand-yellow focus:border-brand-yellow\"\r\n                   placeholder=\"Mínimo 12 caracteres\">\r\n            <p class=\"error-text hidden text-red-600 text-xs mt-1\"></p>\r\n        </div>\r\n\r\n        <button id=\"btnRegistrar\" type=\"submit\"\r\n                class=\"w-full bg-brand-yellow hover:bg-brand-yellowhover text-brand-black font-bold py-3 rounded-lg shadow transition\">\r\n            Registrarse\r\n        </button>\r\n        <div class=\"text-center\">\r\n            <a href=\"#\" id=\"linkVolverPortal\" class=\"text-sm text-gray-500 hover:text-brand-black hover:underline\">\r\n                <i class=\"fa-solid fa-arrow-left mr-1\"></i> Volver al portal\r\n            </a>\r\n        </div>\r\n\r\n        <p class=\"text-center text-sm text-gray-500\">\r\n            ¿Ya tienes cuenta?\r\n            <a href=\"login.html\" class=\"text-brand-black font-semibold hover:underline\">Inicia sesión</a>\r\n        </p>\r\n    </form>\r\n</div>\r\n\r\n<script>\r\n    const form = document.getElementById('formRegistro');\r\n    const btnRegistrar = document.getElementById('btnRegistrar');\r\n    const mensajeGlobal = document.getElementById('mensajeGlobal');\r\n\r\n    // Contador de dígitos del DPI en tiempo real (igual que en CU-00)\r\n    document.getElementById('dpi').addEventListener('input', (e) => {\r\n        e.target.value = e.target.value.replace(/\\D/g, '');\r\n        document.getElementById('dpiContador').textContent = e.target.value.length;\r\n    });\r\n    document.getElementById('telefono').addEventListener('input', (e) => {\r\n        e.target.value = e.target.value.replace(/\\D/g, '');\r\n    });\r\n\r\n    function limpiarErrores() {\r\n        document.querySelectorAll('.error-text').forEach(el => { el.classList.add('hidden'); el.textContent = ''; });\r\n        document.querySelectorAll('input').forEach(el => el.classList.remove('border-red-500'));\r\n        mensajeGlobal.classList.add('hidden');\r\n    }\r\n\r\n    function mostrarMensajeGlobal(texto, tipo) {\r\n        mensajeGlobal.textContent = texto;\r\n        mensajeGlobal.className = tipo === 'error'\r\n            ? 'p-3 rounded-md text-sm bg-red-50 text-red-700 border border-red-200'\r\n            : 'p-3 rounded-md text-sm bg-green-50 text-green-700 border border-green-200';\r\n        mensajeGlobal.classList.remove('hidden');\r\n    }\r\n\r\n    // Mapea el campo que devuelve el error del backend (si viene) a un input.\r\n    // Si tu ValidationException no trae el nombre del campo, el mensaje se\r\n    // muestra igual arriba del formulario (mensajeGlobal), sin marcar un campo específico.\r\n    function mostrarErrorCampo(idCampo, texto) {\r\n        const input = document.getElementById(idCampo);\r\n        const p = input?.nextElementSibling?.classList?.contains('error-text')\r\n            ? input.nextElementSibling\r\n            : input?.parentElement?.querySelector('.error-text');\r\n        if (input) input.classList.add('border-red-500');\r\n        if (p) { p.textContent = texto; p.classList.remove('hidden'); }\r\n    }\r\n\r\n    form.addEventListener('submit', async (e) => {\r\n        e.preventDefault();\r\n        limpiarErrores();\r\n\r\n        const body = {\r\n            nombreCompleto: document.getElementById('nombreCompleto').value.trim(),\r\n            dpi: document.getElementById('dpi').value.trim(),\r\n            nit: document.getElementById('nit').value.trim(),\r\n            telefono: document.getElementById('telefono').value.trim(),\r\n            numeroSeguro: document.getElementById('numeroSeguro').value.trim() || null,\r\n            correoElectronico: document.getElementById('correoElectronico').value.trim(),\r\n            nombreUsuario: document.getElementById('nombreUsuario').value.trim(),\r\n            password: document.getElementById('password').value\r\n        };\r\n\r\n        btnRegistrar.disabled = true;\r\n        btnRegistrar.textContent = 'Registrando...';\r\n\r\n        try {\r\n            const resp = await fetch('/api/register', {\r\n                method: 'POST',\r\n                headers: { 'Content-Type': 'application/json' },\r\n                body: JSON.stringify(body)\r\n            });\r\n            const data = await resp.json().catch(() => ({}));\r\n\r\n            if (!resp.ok) {\r\n                // El GlobalExceptionHandler puede devolver un solo mensaje (ValidationException)\r\n                // o una lista de errores de campo (si usas @Valid con MethodArgumentNotValidException).\r\n                if (data.errors) {\r\n                    // Formato típico de Spring: { errors: { campo: \"mensaje\" } } o similar\r\n                    Object.entries(data.errors).forEach(([campo, msg]) => mostrarErrorCampo(campo, msg));\r\n                    mostrarMensajeGlobal('Revisa los campos marcados en rojo.', 'error');\r\n                } else {\r\n                    mostrarMensajeGlobal(data.mensaje || data.message || 'No se pudo completar el registro.', 'error');\r\n                }\r\n                return;\r\n            }\r\n\r\n            mostrarMensajeGlobal(data.mensaje, 'exito');\r\n            setTimeout(() => { window.location.href = 'login.html'; }, 2000);\r\n\r\n        } catch (err) {\r\n            mostrarMensajeGlobal('No se pudo conectar con el servidor. Intente de nuevo más tarde.', 'error');\r\n        } finally {\r\n            btnRegistrar.disabled = false;\r\n            btnRegistrar.textContent = 'Registrarse';\r\n        }\r\n    });\r\n    document.getElementById('linkVolverPortal').addEventListener('click', (e) => {\r\n        e.preventDefault();\r\n        const confirmado = window.confirm('¿Está seguro que desea salir? Se perderán los datos ingresados en el formulario.');\r\n        if (confirmado) {\r\n            form.reset();\r\n            window.location.href = 'index.html';\r\n        }\r\n    });\r\n</script>\r\n</body>\r\n</html>\r\n
