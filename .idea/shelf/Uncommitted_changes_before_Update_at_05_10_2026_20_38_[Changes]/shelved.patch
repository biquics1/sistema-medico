lect id=\"filtroCampo\" class=\"p-2 border border-gray-300 rounded-md text-sm\">\r\n                            <option value=\"ID\">ID</option>\r\n                            <option value=\"NOMBRE\">Nombre</option>\r\n                            <option value=\"USUARIO\">Nombre de Usuario</option>\r\n                            <option value=\"CORREO\">Correo Electrónico</option>\r\n                            <option value=\"ROL\">Rol</option>\r\n                            <option value=\"DPI\">DPI</option>\r\n                        </select>\r\n                        <input id=\"filtroTexto\" maxlength=\"25\" placeholder=\"Buscar...\"\r\n                               class=\"p-2 border border-gray-300 rounded-md text-sm\">\r\n                        <button onclick=\"renderTablaUsuarios()\"\r\n                                class=\"bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold px-3 py-2 rounded-md text-sm\">\r\n                            <i class=\"fa-solid fa-magnifying-glass\"></i>\r\n                        </button>\r\n                        <button onclick=\"abrirModalUsuario()\"\r\n                                class=\"bg-brand-yellow hover:bg-brand-yellowhover text-brand-black font-bold px-4 py-2 rounded-lg text-sm\">\r\n                            + Crear Usuario\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n\r\n                <div id=\"mensajesUsuarios\"></div>\r\n\r\n                <div class=\"overflow-x-auto\">\r\n                    <table class=\"w-full text-sm text-left\">\r\n                        <thead class=\"bg-gray-50 text-gray-600 uppercase text-xs\">\r\n                        <tr>\r\n                            <th class=\"px-3 py-2\">ID</th>\r\n                            <th class=\"px-3 py-2\">Nombre</th>\r\n                            <th class=\"px-3 py-2\">Correo</th>\r\n                            <th class=\"px-3 py-2\">Rol</th>\r\n                            <th class=\"px-3 py-2\">Usuario</th>\r\n                            <th class=\"px-3 py-2\">Estado</th>\r\n                            <th class=\"px-3 py-2\">Acciones</th>\r\n                        </tr>\r\n                        </thead>\r\n                        <tbody id=\"tablaUsuariosBody\"></tbody>\r\n                    </table>\r\n                </div>\r\n\r\n                <div class=\"flex justify-between items-center mt-4 text-sm text-gray-600\">\r\n                    <div>\r\n                        <span id=\"conteoUsuarios\"></span>\r\n                        <select id=\"usuariosPorPagina\" onchange=\"paginaUsuariosActual = 1; renderTablaUsuarios()\" class=\"ml-2 border border-gray-300 rounded-md p-1\">\r\n                            <option value=\"10\">10</option>\r\n                            <option value=\"25\">25</option>\r\n                            <option value=\"50\">50</option>\r\n                        </select> por página\r\n                    </div>\r\n                    <div class=\"flex gap-2 items-center\">\r\n                        <button onclick=\"cambiarPaginaUsuarios(-1)\" class=\"px-2 py-1 border rounded-md\">‹</button>\r\n                        <span id=\"paginaUsuariosLabel\"></span>\r\n                        <button onclick=\"cambiarPaginaUsuarios(1)\" class=\"px-2 py-1 border rounded-md\">›</button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n\r\n        <!-- Modal crear/editar usuario -->\r\n        <div id=\"modalUsuario\" class=\"hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4\">\r\n            <div class=\"bg-white rounded-xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto\">\r\n                <h3 id=\"modalUsuarioTitulo\" class=\"text-lg font-bold text-brand-black mb-4\">Crear Usuario</h3>\r\n                <div id=\"mensajesModalUsuario\"></div>\r\n\r\n                <form id=\"formUsuario\" class=\"space-y-3\">\r\n                    <input type=\"hidden\" id=\"usuarioId\">\r\n\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700\">Nombre Completo</label>\r\n                        <input id=\"uNombreCompleto\" class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700\">Correo Electrónico</label>\r\n                        <input id=\"uCorreoElectronico\" type=\"email\" class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700\">Nombre de Usuario</label>\r\n                        <input id=\"uNombreUsuario\" maxlength=\"9\" class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700\">\r\n                            Contraseña <span id=\"labelPasswordOpcional\" class=\"text-gray-400 text-xs hidden\">(dejar en blanco para no cambiarla)</span>\r\n                        </label>\r\n                        <input id=\"uPassword\" type=\"password\" class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                    </div>\r\n                    <div class=\"grid grid-cols-2 gap-3\">\r\n                        <div>\r\n                            <label class=\"block text-sm font-medium text-gray-700\">DPI (opcional)</label>\r\n                            <input id=\"uDpi\" maxlength=\"13\" class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                        </div>\r\n                        <div>\r\n                            <label class=\"block text-sm font-medium text-gray-700\">Teléfono (opcional)</label>\r\n                            <input id=\"uTelefono\" maxlength=\"8\" class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"grid grid-cols-2 gap-3\">\r\n                        <div>\r\n                            <label class=\"block text-sm font-medium text-gray-700\">NIT (opcional)</label>\r\n                            <input id=\"uNit\" maxlength=\"9\" class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                        </div>\r\n                        <div>\r\n                            <label class=\"block text-sm font-medium text-gray-700\">No. Seguro (opcional)</label>\r\n                            <input id=\"uNumeroSeguro\" class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                        </div>\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700\">Rol</label>\r\n                        <select id=\"uRolId\" onchange=\"toggleCampoEspecialidad()\" class=\"w-full p-2 border border-gray-300 rounded-md\"></select>\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700\">Sucursal</label>\r\n                        <select id=\"uSucursalId\" class=\"w-full p-2 border border-gray-300 rounded-md\"></select>\r\n                    </div>\r\n                    <div id=\"campoEspecialidadUsuario\" class=\"hidden\">\r\n                        <label class=\"block text-sm font-medium text-gray-700\">Especialidad (solo médicos)</label>\r\n                        <select id=\"uEspecialidadId\" class=\"w-full p-2 border border-gray-300 rounded-md\"></select>\r\n                    </div>\r\n                    <div>\r\n                        <label class=\"block text-sm font-medium text-gray-700\">Estado</label>\r\n                        <select id=\"uEstado\" class=\"w-full p-2 border border-gray-300 rounded-md\">\r\n                            <option value=\"1\">Activo</option>\r\n                            <option value=\"0\">Inactivo</option>\r\n                        </select>\r\n                    </div>\r\n\r\n                    <div class=\"flex gap-2 pt-2\">\r\n                        <button type=\"button\" onclick=\"cerrarModalUsuario()\"\r\n                                class=\"flex-1 bg-gray-200 text-gray-800 font-semibold py-2 rounded-lg\">Cancelar</button>\r\n                        <button type=\"button\" onclick=\"guardarUsuario()\"\r\n                                class=\"flex-1 bg-brand-yellow hover:bg-brand-yellowhover text-brand-black font-bold py-2 rounded-lg\">Guardar</button>\r\n                    </div>\r\n                </form>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Modal confirmar eliminación -->\r\n        <div id=\"modalEliminarUsuario\" class=\"hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4\">\r\n            <div class=\"bg-white rounded-xl p-6 w-full max-w-sm text-center\">\r\n                <i class=\"fa-solid fa-triangle-exclamation text-4xl text-red-500 mb-3\"></i>\r\n                <p class=\"text-gray-700 mb-4\" id=\"mensajeConfirmarEliminar\"></p>\r\n                <div class=\"flex gap-2\">\r\n                    <button onclick=\"cerrarModalEliminarUsuario()\" class=\"flex-1 bg-gray-200 text-gray-800 font-semibold py-2 rounded-lg\">Cancelar</button>\r\n                    <button onclick=\"confirmarEliminarUsuario()\" class=\"flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-2 rounded-lg\">Eliminar</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n</main>\r\n\r\n<script src=\"common.js\"></script>\r\n<script>\r\n    // ============================================================\r\n    // Página: usuarios\r\n    //\r\n    // IMPORTANTE (fix del error \"abrirModalUsuario is not defined\"):\r\n    // Las funciones que se invocan desde atributos onclick=\"...\" del\r\n    // HTML DEBEN quedar declaradas en el nivel superior del <script>,\r\n    // NUNCA dentro de un bloque if/else. Una función declarada dentro\r\n    // de un bloque puede no quedar expuesta de forma global, y por\r\n    // eso el botón \"Editar\" (generado dinámicamente en el <tbody>)\r\n    // no la encontraba. Aquí solo usamos el resultado de\r\n    // protegerPagina() para decidir si cargamos los datos al final,\r\n    // pero las funciones siempre se definen.\r\n    // ============================================================\r\n    const tieneAccesoUsuarios = protegerPagina();\r\n\r\n    // CU-01: Gestión de Usuarios\r\n    let usuariosCache = [];\r\n    let rolesCache = [];\r\n    let sucursalesCache = [];\r\n    let especialidadesCache = [];\r\n    let paginaUsuariosActual = 1;\r\n    let idUsuarioAEliminar = null;\r\n\r\n    function mostrarMensajeUsuarios(texto, tipo) {\r\n        const colores = {\r\n            error: 'bg-red-50 text-red-700 border border-red-200',\r\n            exito: 'bg-green-50 text-green-700 border border-green-200'\r\n        };\r\n        document.getElementById('mensajesUsuarios').innerHTML =\r\n            `<div class=\"p-3 rounded-md mb-4 ${colores[tipo]}\">${texto}</div>`;\r\n    }\r\n\r\n    async function cargarCatalogosUsuario() {\r\n        [rolesCache, sucursalesCache, especialidadesCache] = await Promise.all([\r\n            apiFetch('/api/roles'),\r\n            apiFetch('/api/sucursales'),\r\n            apiFetch('/api/especialidades')\r\n        ]);\r\n\r\n        // NUEVO: un Administrador de Sede (rol \"Administrador\", no \"Administrador\r\n        // General\") no puede crear/asignar el rol \"Administrador General\", y solo\r\n        // puede trabajar dentro de su propia sucursal. El backend ya lo valida\r\n        // (UsuarioService.crear/actualizar), esto es solo para que el formulario\r\n        // no ofrezca opciones que de todos modos van a ser rechazadas.\r\n        const esAdminDeSede = rolActual === 'Administrador';\r\n        const rolesParaFormulario = esAdminDeSede\r\n            ? rolesCache.filter(r => r.nombre !== 'Administrador General')\r\n            : rolesCache;\r\n\r\n        const selectRol = document.getElementById('uRolId');\r\n        selectRol.innerHTML = rolesParaFormulario.map(r => `<option value=\"${r.id}\">${r.nombre}</option>`).join('');\r\n\r\n        const selectSucursal = document.getElementById('uSucursalId');\r\n        selectSucursal.innerHTML = '<option value=\"\">-- Seleccione --</option>' +\r\n            sucursalesCache.map(s => `<option value=\"${s.id}\">${s.nombre}</option>`).join('');\r\n\r\n        if (esAdminDeSede) {\r\n            const miSucursalId = sessionStorage.getItem('sucursalId') || '';\r\n            selectSucursal.value = miSucursalId;\r\n            selectSucursal.disabled = true;\r\n        } else {\r\n            selectSucursal.disabled = false;\r\n        }\r\n\r\n        const selectEspecialidad = document.getElementById('uEspecialidadId');\r\n        selectEspecialidad.innerHTML = '<option value=\"\">-- Seleccione --</option>' +\r\n            especialidadesCache.map(e => `<option value=\"${e.id}\">${e.nombre}</option>`).join('');\r\n    }\r\n\r\n    function toggleCampoEspecialidad() {\r\n        const rolSeleccionado = rolesCache.find(r => r.id == document.getElementById('uRolId').value);\r\n        const esMedico = rolSeleccionado && rolSeleccionado.nombre === 'Médico';\r\n        document.getElementById('campoEspecialidadUsuario').classList.toggle('hidden', !esMedico);\r\n    }\r\n\r\n    async function cargarUsuarios() {\r\n        paginaUsuariosActual = 1;\r\n        await renderTablaUsuarios();\r\n    }\r\n\r\n    // CU-01 FB paso 6/7 (RN-CU01-01/02): búsqueda server-side vía GET /api/users/buscar\r\n    async function renderTablaUsuarios() {\r\n        const campo = document.getElementById('filtroCampo').value;\r\n        const valor = document.getElementById('filtroTexto').value.trim();\r\n        const tamano = Number(document.getElementById('usuariosPorPagina').value);\r\n        const tbody = document.getElementById('tablaUsuariosBody');\r\n\r\n        try {\r\n            const params = new URLSearchParams({\r\n                campo,\r\n                pagina: String(paginaUsuariosActual - 1), // backend es 0-based\r\n                tamano: String(tamano)\r\n            });\r\n            if (valor) params.set('valor', valor);\r\n\r\n            const resp = await apiFetch(`/api/users/buscar?${params.toString()}`);\r\n            usuariosCache = resp.contenido;\r\n\r\n            if (usuariosCache.length === 0) {\r\n                tbody.innerHTML = `<tr><td colspan=\"7\" class=\"text-center text-red-500 py-4\">No se encontraron datos usuarios.</td></tr>`;\r\n            } else {\r\n                tbody.innerHTML = usuariosCache.map(u => `\r\n                <tr class=\"border-t border-gray-100\">\r\n                    <td class=\"px-3 py-2\">${u.id}</td>\r\n                    <td class=\"px-3 py-2\">${u.nombreCompleto}</td>\r\n                    <td class=\"px-3 py-2\">${u.correoElectronico}</td>\r\n                    <td class=\"px-3 py-2\">${u.rolNombre}</td>\r\n                    <td class=\"px-3 py-2\">${u.nombreUsuario}</td>\r\n                    <td class=\"px-3 py-2\">\r\n                        <span class=\"px-2 py-1 rounded-full text-xs font-bold ${u.estado === 1 ? 'bg-green-100 text-green-700' : 'bg-gray-200 text-gray-600'}\">\r\n                            ${u.estado === 1 ? 'Activo' : 'Inactivo'}\r\n                        </span>\r\n                    </td>\r\n                    <td class=\"px-3 py-2\">\r\n                        <button onclick=\"abrirModalUsuario(${u.id})\" class=\"text-blue-600 hover:underline mr-2\">Editar</button>\r\n                        <button onclick=\"abrirModalEliminarUsuario(${u.id}, '${u.nombreUsuario}')\" class=\"text-orange-600 hover:underline\">Eliminar</button>\r\n                    </td>\r\n                </tr>\r\n            `).join('');\r\n            }\r\n\r\n            document.getElementById('conteoUsuarios').innerText = `${resp.totalElementos} registro(s)`;\r\n            document.getElementById('paginaUsuariosLabel').innerText = `${resp.pagina + 1} / ${Math.max(1, resp.totalPaginas)}`;\r\n        } catch (e) {\r\n            tbody.innerHTML = `<tr><td colspan=\"7\" class=\"text-center text-red-500 py-4\">No se encontraron datos usuarios.</td></tr>`;\r\n            mostrarMensajeUsuarios(e.message, 'error');\r\n        }\r\n    }\r\n\r\n    function cambiarPaginaUsuarios(delta) {\r\n        paginaUsuariosActual = Math.max(1, paginaUsuariosActual + delta);\r\n        renderTablaUsuarios();\r\n    }\r\n\r\n    async function abrirModalUsuario(id) {\r\n        document.getElementById('formUsuario').reset();\r\n        document.getElementById('mensajesModalUsuario').innerHTML = '';\r\n        document.getElementById('usuarioId').value = '';\r\n        await cargarCatalogosUsuario();\r\n\r\n        if (id) {\r\n            document.getElementById('modalUsuarioTitulo').innerText = 'Editar Usuario';\r\n            document.getElementById('labelPasswordOpcional').classList.remove('hidden');\r\n            try {\r\n                const u = await apiFetch(`/api/users/${id}`);\r\n                document.getElementById('usuarioId').value = u.id;\r\n                document.getElementById('uNombreCompleto').value = u.nombreCompleto;\r\n                document.getElementById('uCorreoElectronico').value = u.correoElectronico;\r\n                document.getElementById('uNombreUsuario').value = u.nombreUsuario;\r\n                document.getElementById('uDpi').value = u.dpi || '';\r\n                document.getElementById('uTelefono').value = u.telefono || '';\r\n                const rol = rolesCache.find(r => r.nombre === u.rolNombre);\r\n                if (rol) document.getElementById('uRolId').value = rol.id;\r\n                const sucursal = sucursalesCache.find(s => s.nombre === u.sucursalNombre);\r\n                if (sucursal) document.getElementById('uSucursalId').value = sucursal.id;\r\n                const especialidad = especialidadesCache.find(e => e.nombre === u.especialidadNombre);\r\n                if (especialidad) document.getElementById('uEspecialidadId').value = especialidad.id;\r\n                document.getElementById('uEstado').value = u.estado;\r\n                toggleCampoEspecialidad();\r\n            } catch (e) {\r\n                mostrarMensajeUsuarios(e.message, 'error');\r\n                return;\r\n            }\r\n        } else {\r\n            document.getElementById('modalUsuarioTitulo').innerText = 'Crear Usuario';\r\n            document.getElementById('labelPasswordOpcional').classList.add('hidden');\r\n            document.getElementById('uEstado').value = '1';\r\n        }\r\n\r\n        document.getElementById('modalUsuario').classList.remove('hidden');\r\n    }\r\n\r\n    function cerrarModalUsuario() {\r\n        document.getElementById('modalUsuario').classList.add('hidden');\r\n    }\r\n\r\n    async function guardarUsuario() {\r\n        const id = document.getElementById('usuarioId').value;\r\n        const body = {\r\n            nombreCompleto: document.getElementById('uNombreCompleto').value.trim(),\r\n            correoElectronico: document.getElementById('uCorreoElectronico').value.trim(),\r\n            nombreUsuario: document.getElementById('uNombreUsuario').value.trim(),\r\n            password: document.getElementById('uPassword').value,\r\n            dpi: document.getElementById('uDpi').value.trim() || null,\r\n            telefono: document.getElementById('uTelefono').value.trim() || null,\r\n            nit: document.getElementById('uNit').value.trim() || null,\r\n            numeroSeguro: document.getElementById('uNumeroSeguro').value.trim() || null,\r\n            rolId: Number(document.getElementById('uRolId').value),\r\n            sucursalId: document.getElementById('uSucursalId').value ? Number(document.getElementById('uSucursalId').value) : null,\r\n            especialidadId: document.getElementById('uEspecialidadId').value ? Number(document.getElementById('uEspecialidadId').value) : null,\r\n            estado: Number(document.getElementById('uEstado').value)\r\n        };\r\n\r\n        try {\r\n            if (id) {\r\n                await apiFetch(`/api/users/${id}`, { method: 'PUT', body: JSON.stringify(body) });\r\n                mostrarMensajeUsuarios('Usuario actualizado correctamente.', 'exito');\r\n            } else {\r\n                await apiFetch('/api/users', { method: 'POST', body: JSON.stringify(body) });\r\n                mostrarMensajeUsuarios('Usuario creado correctamente.', 'exito');\r\n            }\r\n            cerrarModalUsuario();\r\n            cargarUsuarios();\r\n        } catch (e) {\r\n            document.getElementById('mensajesModalUsuario').innerHTML =\r\n                `<div class=\"p-3 rounded-md mb-3 bg-red-50 text-red-700 border border-red-200\">${e.message}</div>`;\r\n        }\r\n    }\r\n\r\n    function abrirModalEliminarUsuario(id, nombreUsuario) {\r\n        idUsuarioAEliminar = id;\r\n        document.getElementById('mensajeConfirmarEliminar').innerText =\r\n            `¿Está seguro que desea eliminar el usuario \"${nombreUsuario}\"? Esta acción no se puede deshacer.`;\r\n        document.getElementById('modalEliminarUsuario').classList.remove('hidden');\r\n    }\r\n\r\n    function cerrarModalEliminarUsuario() {\r\n        document.getElementById('modalEliminarUsuario').classList.add('hidden');\r\n        idUsuarioAEliminar = null;\r\n    }\r\n\r\n    async function confirmarEliminarUsuario() {\r\n        try {\r\n            await apiFetch(`/api/users/${idUsuarioAEliminar}`, { method: 'DELETE' });\r\n            cerrarModalEliminarUsuario();\r\n            mostrarMensajeUsuarios('El usuario ha sido eliminado correctamente.', 'exito');\r\n            cargarUsuarios();\r\n        } catch (e) {\r\n            cerrarModalEliminarUsuario();\r\n            mostrarMensajeUsuarios(e.message, 'error');\r\n        }\r\n    }\r\n\r\n    // Carga inicial de datos: solo si el usuario tiene acceso a este módulo.\r\n    if (tieneAccesoUsuarios) {\r\n        cargarUsuarios();\r\n    }\r\n</script>\r\n</body>\r\n</html>
