+
+    // Marca cada campo con error y devuelve los mensajes que no corresponden a ningún campo
+    function mostrarErroresPago(errores) {
+        const sinCampo = [];
+        Object.entries(errores).forEach(([campo, mensaje]) => {
+            const input = document.getElementById(CAMPOS_PAGO[campo]);
+            if (!input) { sinCampo.push(mensaje); return; }
+            input.classList.remove('border-gray-300');
+            input.classList.add('border-red-500');
+            const p = document.createElement('p');
+            p.className = 'error-campo text-xs text-red-600 mt-1';
+            p.textContent = mensaje;
+            input.insertAdjacentElement('afterend', p);
+        });
+        return sinCampo;
+    }
