}


### ============ CU-07: Toma de Signos Vitales ============

GET http://localhost:8080/api/enfermeria/cola
Authorization: Bearer {{loginEnfermero.response.body.$.token}}

POST http://localhost:8080/api/enfermeria/citas/1/llamar
Authorization: Bearer {{loginEnfermero.response.body.$.token}}

### Registrar signos vitales normales — idEnfermero ya NO va en el body, sale del token
POST http://localhost:8080/api/enfermeria/citas/1/signos-vitales
Authorization: Bearer {{loginEnfermero.response.body.$.token}}
Content-Type: application/json

{
  "presionSistolica": 120,
  "presionDiastolica": 80,
  "temperatura": 36.8,
  "peso": 70.5,
  "talla": 170.0,
  "frecuenciaCardiaca": 75,
  "esEmergencia": false
}

### Alternativa: valores fuera de rango clínico (dispara alertas, FA03)
POST http://localhost:8080/api/enfermeria/citas/1/signos-vitales
Authorization: Bearer {{loginEnfermero.response.body.$.token}}
Content-Type: application/json

{
  "presionSistolica": 150,
  "presionDiastolica": 95,
  "temperatura": 38.5,
  "peso": 70.5,
  "talla": 170.0,
  "frecuenciaCardiaca": 110,
  "esEmergencia": false
}

### Alternativa: emergencia (FA01)
POST http://localhost:8080/api/enfermeria/citas/1/signos-vitales
Authorization: Bearer {{loginEnfermero.response.body.$.token}}
Content-Type: application/json

{
  "presionSistolica": 120,
  "presionDiastolica": 80,
  "temperatura": 36.8,
  "peso": 70.5,
  "talla": 170.0,
  "frecuenciaCardiaca": 75,
  "esEmergencia": true
}


### ============ CU-08: Consulta Médica ============
### medicoId ya NO va como query param: sale del token

GET http://localhost:8080/api/medico/panel
Authorization: Bearer {{loginMedico.response.body.$.token}}

POST http://localhost:8080/api/medico/citas/1/iniciar-consulta
Authorization: Bearer {{loginMedico.response.body.$.token}}

GET http://localhost:8080/api/medico/citas/1/consulta
Authorization: Bearer {{loginMedico.response.body.$.token}}

GET http://localhost:8080/api/medico/cie10?query=faringitis
Authorization: Bearer {{loginMedico.response.body.$.token}}

### Guardar consulta como BORRADOR (En curso)
PUT http://localhost:8080/api/medico/citas/1/consulta
Authorization: Bearer {{loginMedico.response.body.$.token}}
Content-Type: application/json

{
  "motivoVisita": "Dolor de garganta y fiebre desde hace 2 días",
  "hallazgosClinicos": "Faringe eritematosa, amígdalas inflamadas",
  "cie10Id": 2,
  "diagnostico": null,
  "planTratamiento": null,
  "notasAdicionales": null,
  "estadoConsulta": "EN_CURSO"
}

### Finalizar consulta (Consulta Médica -> Evaluado). Requiere diagnóstico (FA05)
PUT http://localhost:8080/api/medico/citas/1/consulta
Authorization: Bearer {{loginMedico.response.body.$.token}}
Content-Type: application/json

{
  "motivoVisita": "Dolor de garganta y fiebre desde hace 2 días",
  "hallazgosClinicos": "Faringe eritematosa, amígdalas inflamadas",
  "cie10Id": 2,
  "diagnostico": "Faringitis aguda bacteriana, sin complicaciones",
  "planTratamiento": "Antibiótico por 7 días, reposo, abundantes líquidos",
  "notasAdicionales": "Control en caso de persistir fiebre tras 48 horas",
  "estadoConsulta": "FINALIZADA"
}

GET http://localhost:8080/api/medico/examenes
Authorization: Bearer {{loginMedico.response.body.$.token}}

### Generar orden de laboratorio (FA01) — cambia el 1 por el id real de la ConsultaMedica
POST http://localhost:8080/api/medico/consultas/1/orden-laboratorio
Authorization: Bearer {{loginMedico.response.body.$.token}}
Content-Type: application/json

{
  "examenIds": [1, 2],
  "esExterna": false,
  "notas": "Descartar proceso infeccioso"
}

GET http://localhost:8080/api/medico/medicamentos
Authorization: Bearer {{loginMedico.response.body.$.token}}

### Generar receta médica (FA04)
POST http://localhost:8080/api/medico/consultas/1/receta
Authorization: Bearer {{loginMedico.response.body.$.token}}
Content-Type: application/json

{
  "detalles": [
    {
      "medicamentoId": 3,
      "dosis": "500mg",
      "frecuencia": "Cada 8 horas",
      "duracion": "7 días",
      "indicaciones": "Tomar con alimentos"
    }
  ]
}

POST http://localhost:8080/api/medico/citas/1/no-asistio
Authorization: Bearer {{loginMedico.response.body.$.token}}

POST http://localhost:8080/api/medico/citas/1/finalizar-atencion
Authorization: Bearer {{loginMedico.response.body.$.token}}


### ============ CU-09: Gestión de Laboratorio ============

GET http://localhost:8080/api/laboratorio/ordenes?estado=0
Authorization: Bearer {{loginLaboratorista.response.body.$.token}}

GET http://localhost:8080/api/laboratorio/ordenes/1
Authorization: Bearer {{loginLaboratorista.response.body.$.token}}

PUT http://localhost:8080/api/laboratorio/ordenes/1/examenes/1/resultado
Authorization: Bearer {{loginLaboratorista.response.body.$.token}}
Content-Type: application/json

{
  "valorResultado": "4.8",
  "unidad": "millones/uL",
  "fueraDeRango": false,
  "notasResultado": "Dentro de parámetros normales"
}

POST http://localhost:8080/api/laboratorio/ordenes/1/examenes/1/publicar
Authorization: Bearer {{loginLaboratorista.response.body.$.token}}


