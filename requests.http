### ============ CU-00 FA06/FA07: credenciales incorrectas / bloqueo (RN-CU00-03) ============
### Ejecuta esto 5 veces seguidas con la misma contraseña mala: al 5to intento
### debe responder "Cuenta bloqueada temporalmente. Intente de nuevo en 15 minutos."
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "nombreUsuario": "paciente1",
  "password": "clave-incorrecta"
}


### ============ CU-01: Mantenimiento de Usuarios (solo Administrador) ============

GET http://localhost:8080/api/users
Authorization: Bearer {{loginAdmin.response.body.$.token}}

GET http://localhost:8080/api/users/buscar?campo=NOMBRE&valor=Ana&pagina=0&tamano=20
Authorization: Bearer {{loginAdmin.response.body.$.token}}

POST http://localhost:8080/api/users
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "nombreCompleto": "Juan Pérez López",
  "correoElectronico": "juan.perez@hospital.com",
  "nombreUsuario": "jperez01",
  "password": "ClaveSegura123",
  "rolId": 1,
  "sucursalId": 1
}

GET http://localhost:8080/api/users/1
Authorization: Bearer {{loginAdmin.response.body.$.token}}

DELETE http://localhost:8080/api/users/1
Authorization: Bearer {{loginAdmin.response.body.$.token}}


